# =============================================================================
# VOICE-ENABLED CHATBOT CONFIGURATION
# =============================================================================
NODE_ENV=development
APP_NAME=voice-chatbot
APP_VERSION=1.0.0
APP_PORT=3000
APP_HOST=0.0.0.0
DEBUG=true

# =============================================================================
# SPEECHMATICS CONFIGURATION
# =============================================================================
SPEECHMATICS_API_KEY=uT6VnTyO2seykGvFDyNP2R986gyIZSOT
SPEECHMATICS_RT_URL=wss://eu2.rt.speechmatics.com/v2
SPEECHMATICS_BATCH_URL=https://asr.api.speechmatics.com/v2
SPEECHMATICS_DEFAULT_LANGUAGE=en
SPEECHMATICS_ENABLE_PARTIALS=true
SPEECHMATICS_MAX_DELAY=5
SPEECHMATICS_ENABLE_ENTITIES=true
SPEECHMATICS_ENABLE_SENTIMENT=true
SPEECHMATICS_ENABLE_TOPICS=true

# Speechmatics TTS Configuration
SPEECHMATICS_TTS_ENABLED=true
SPEECHMATICS_TTS_VOICE=default
SPEECHMATICS_TTS_SPEED=1.0
SPEECHMATICS_TTS_PITCH=1.0

# =============================================================================
# AI CHATBOT CONFIGURATION (Fallback Hierarchy)
# =============================================================================
# Primary: Kong API Gateway (Local LLM)
KONG_API_URL=http://kong-api:8000
KONG_API_KEY=your-kong-api-key
KONG_MODEL_ENDPOINT=/v1/chat/completions
KONG_DEFAULT_MODEL=local-llm

# Fallback 1: Local Ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_DEFAULT_MODEL=llama2
OLLAMA_TIMEOUT=30000
OLLAMA_MAX_TOKENS=2000
OLLAMA_TEMPERATURE=0.7

# Fallback 2: OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
OPENAI_TOP_P=1.0
OPENAI_FREQUENCY_PENALTY=0.0
OPENAI_PRESENCE_PENALTY=0.0
OPENAI_TIMEOUT=30000
OPENAI_ORGANIZATION=org-your-org-id

# AI Response Configuration
AI_RESPONSE_MAX_LENGTH=500
AI_RESPONSE_TIMEOUT=30000
AI_FALLBACK_ENABLED=true
AI_FALLBACK_ORDER=kong,ollama,openai

# =============================================================================
# TEXT-TO-SPEECH CONFIGURATION (Fallback Hierarchy)
# =============================================================================
# Primary: Speechmatics TTS
TTS_PRIMARY_PROVIDER=speechmatics
TTS_SPEECHMATICS_ENABLED=true

# Fallback: Local TTS
TTS_FALLBACK_PROVIDER=local
TTS_LOCAL_ENABLED=true
TTS_LOCAL_ENGINE=espeak
TTS_LOCAL_VOICE=en-us
TTS_LOCAL_SPEED=150
TTS_LOCAL_PITCH=50

# TTS Configuration
TTS_AUDIO_FORMAT=wav
TTS_SAMPLE_RATE=22050
TTS_CHANNELS=1
TTS_BIT_DEPTH=16

# =============================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=voice_chatbot_db
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT=60000

# Database URL (alternative format)
DATABASE_URL=postgresql://postgres:postgres_password@postgres:5432/voice_chatbot_db

# =============================================================================
# REDIS CONFIGURATION (For Session Management)
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_URL=redis://:redis_password@redis:6379/0

# Redis Connection Pool
REDIS_POOL_SIZE=10
REDIS_CONNECT_TIMEOUT=10000
REDIS_COMMAND_TIMEOUT=5000

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================
WS_ENABLED=true
WS_PORT=3001
WS_CORS_ORIGIN=http://localhost:3000,http://localhost:3001
WS_HEARTBEAT_INTERVAL=30
WS_MAX_CONNECTIONS=100

# =============================================================================
# VOICE ACTIVITY DETECTION (VAD)
# =============================================================================
VAD_ENABLED=true
VAD_SILENCE_THRESHOLD=0.3
VAD_SPEECH_THRESHOLD=0.5
VAD_MIN_SPEECH_DURATION=0.5
VAD_MAX_SILENCE_DURATION=2.0
VAD_FRAME_SIZE=1024
VAD_SAMPLE_RATE=16000

# =============================================================================
# AUDIO PROCESSING CONFIGURATION
# =============================================================================
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_BIT_DEPTH=16
AUDIO_FORMAT=pcm_s16le
AUDIO_CHUNK_SIZE=4096
AUDIO_BUFFER_SIZE=8192

# Audio File Upload/Download
AUDIO_UPLOAD_MAX_SIZE=50MB
AUDIO_UPLOAD_ALLOWED_FORMATS=wav,mp3,flac,m4a,ogg
AUDIO_STORAGE_PATH=/app/audio_storage
AUDIO_CLEANUP_INTERVAL=3600

# =============================================================================
# MULTI-LANGUAGE SUPPORT
# =============================================================================
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ru,ja,ko,zh
DEFAULT_LANGUAGE=en
AUTO_DETECT_LANGUAGE=true
LANGUAGE_DETECTION_CONFIDENCE=0.8

# Language-specific configurations
LANG_EN_NAME=English
LANG_ES_NAME=Spanish
LANG_FR_NAME=French
LANG_DE_NAME=German
LANG_IT_NAME=Italian
LANG_PT_NAME=Portuguese
LANG_RU_NAME=Russian
LANG_JA_NAME=Japanese
LANG_KO_NAME=Korean
LANG_ZH_NAME=Chinese

# =============================================================================
# CONVERSATION HISTORY PERSISTENCE
# =============================================================================
CONVERSATION_HISTORY_ENABLED=true
CONVERSATION_HISTORY_RETENTION_DAYS=30
CONVERSATION_HISTORY_MAX_MESSAGES=1000
CONVERSATION_HISTORY_ENCRYPTION=true
CONVERSATION_HISTORY_BACKUP_ENABLED=true
CONVERSATION_HISTORY_BACKUP_INTERVAL=24

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-for-voice-chatbot
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Encryption keys
ENCRYPTION_KEY=your-32-char-encryption-key-here-voice
HASH_ROUNDS=12

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
CORS_CREDENTIALS=true

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs/app.log
LOG_MAX_FILES=5
LOG_MAX_SIZE=10m

# Sentry (Error Tracking)
SENTRY_DSN=your-sentry-dsn-here
SENTRY_ENVIRONMENT=development

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_VOICE_REQUESTS_PER_MINUTE=20

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================
# Hot reload
HOT_RELOAD=true

# API Documentation
API_DOCS_ENABLED=true
API_DOCS_PATH=/docs

# Testing
TEST_DB_NAME=voice_chatbot_test_db
TEST_REDIS_DB=1

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================
# Container Configuration
CONTAINER_PORT=3000
HEALTH_CHECK_ENDPOINT=/health
READINESS_CHECK_ENDPOINT=/ready

# Kubernetes
K8S_NAMESPACE=default
K8S_SERVICE_NAME=voice-chatbot-service

# =============================================================================
# FEATURE FLAGS
# =============================================================================
FEATURE_VOICE_CHAT=true
FEATURE_FILE_UPLOAD=true
FEATURE_CONVERSATION_HISTORY=true
FEATURE_MULTI_LANGUAGE=true
FEATURE_VOICE_ACTIVITY_DETECTION=true
FEATURE_REAL_TIME_TRANSCRIPTION=true
FEATURE_TEXT_TO_SPEECH=true
FEATURE_AI_FALLBACK=true
